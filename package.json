{
  "name": "@alloy-ts/engine",
  "version": "0.0.0",
  "description": "Versioned module repo for alloy-ts projects.",
  "keywords": [
    "ecmascript",
    "interpreter",
    "javascript",
    "napi",
    "napi-rs",
    "runtime"
  ],
  "license": "Unlicense",
  "author": "Yumin Chen",
  "repository": {
    "type": "git",
    "url": "git+https://repo.chen.software/alloy-ts/engine.git"
  },
  "bin": {
    "alloy-engine": "./bin/alloy-engine.mjs",
    "engine": "./bin/alloy-engine.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node --import @oxc-node/core/register build.ts && vp pack",
    "dev": "vp pack --watch",
    "start": "vp run dist/index.js",
    "example": "node --import @oxc-node/core/register examples/engine.ts",
    "test": "node --import @oxc-node/core/register --test 'src/**/*.test.ts' && cargo test",
    "test:conformance": "node --import @oxc-node/core/register --test src/conformance.test.ts",
    "check": "vp check && cargo check --all-targets",
    "fmt": "vp fmt && cargo fmt",
    "lint": "vp lint && cargo clippy --all-targets",
    "fix": "vp fmt && cargo clippy --fix --all-targets --allow-dirty --allow-staged && vp check --fix",
    "prepublishOnly": "npm run build",
    "install": "npm run build",
    "prepare": "node --import @oxc-node/core/register scripts/setup.ts"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@napi-rs/cli": "^3.10.8",
    "@oxc-node/core": "^0.1.7",
    "@types/node": "^26.6.5",
    "emnapi": "^1.11.3",
    "vite-plus": "1.6.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "napi": {
    "binaryName": "alloy-engine",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "i686-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "armv7-unknown-linux-gnueabihf",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "aarch64-linux-android",
      "armv7-linux-androideabi",
      "x86_64-unknown-freebsd",
      "wasm32-wasip1-threads"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.11.0",
      "onFail": "warn"
    }
  }
}
