{
	"name": "@alloyscript/engine",
	"type": "module",
	"private": true,
	"module": "./dist/artefact/schemascript/index.js",
	"types": "./dist/artefact/schemascript/index.d.ts",
	"bin": {
		"@artefacto/schemascript": "./dist/main.js"
	},
	"exports": {
		".": "./dist/artefact/schemascript/index.js"
	},
	"scripts": {
		"fix": "bun run check",
		"check": "bun x --bun @biomejs/biome check --fix .",
		"format": "bun x --bun @biomejs/biome format --fix .",
		"lint": "bun x --bun @biomejs/biome lint --fix .",
		"start": "bun run src/main.ts",
		"transpile:bootstrap": "bun run src/main.ts transpile src/core/runtime_bootstrap.ts --out gen/runtime_bootstrap.es5.js",
		"transpile:shims": "bun run src/main.ts transpile src/shims/web_api_shims.ts --out gen/web_api_shims.es5.js",
		"transpile": "bun run transpile:bootstrap && bun run transpile:shims"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@babel/generator": "^7.29.1",
		"@babel/template": "^7.28.6",
		"@babel/traverse": "^7.29.0",
		"@babel/types": "^7.29.0",
		"@biomejs/biome": "^2.4.5",
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@iarna/toml": "^2.2.5",
		"fast-check": "^4.6.0",
		"zod": "3.24.2"
	}
}
