{
	"name": "@alloyscript/engine",
	"module": "src/main.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"fix": "bun run check",
		"check": "bun x --bun @biomejs/biome check --fix .",
		"format": "bun x --bun @biomejs/biome format --fix .",
		"lint": "bun x --bun @biomejs/biome lint --fix .",
		"start": "bun run src/main.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.5",
		"@types/bun": "latest",
		"fast-check": "^4.6.0"
	},
	"peerDependencies": {
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"acorn": "^8.16.0",
		"acorn-walk": "^8.3.5",
		"astring": "^1.9.0"
	}
}
