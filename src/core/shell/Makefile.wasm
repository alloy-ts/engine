# Makefile for shell.wasm

CC = wasm-cc
CFLAGS = -O2 -Wall
TARGET = shell.wasm

SRCS = lexer.c parser.c builtins.c interpreter.c shell_main.c escape.c pipe.c redirect.c native_wit.c
OBJS = $(SRCS:.c=.o)

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) -o $(TARGET) $(OBJS)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS) $(TARGET)
