CC = clang
CFLAGS = -O2 -Wall

SRCS = lexer.c parser.c escape.c pipe.c redirect.c builtins.c interpreter.c alloy_shell_main.c
OBJS = $(SRCS:.c=.o)
TARGET = shell.wasm

# Default to host build for verification if wasi-sdk not present
all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) -o $@ $^

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS) $(TARGET)
